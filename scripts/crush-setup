#!/usr/bin/env bash

# crush-setup - Configure Crush AI assistant for spacehound
# Usage: crush-setup [--reconfigure|--show-config]

set -e

CRUSH_CONFIG_DIR="${HOME}/.config/crush"
CRUSH_CONFIG="${CRUSH_CONFIG_DIR}/config.toml"
NEBULANIX_URL="http://192.168.1.10:11434/v1"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
  echo "Usage: $0 [COMMAND]"
  echo ""
  echo "Commands:"
  echo "  (no args)        Run setup wizard"
  echo "  --reconfigure    Re-run configuration"
  echo "  --show-config    Display current config"
  echo "  --help           Show this help"
  echo ""
  echo "Crush is an AI coding agent by Charmbracelet"
  echo "It provides LSP integration and project-based sessions"
  exit 0
}

check_gum() {
  if ! command -v gum &>/dev/null; then
    echo -e "${YELLOW}Installing gum...${NC}"
    brew install gum 2>/dev/null || nix-env -iA nixpkgs.gum 2>/dev/null || {
      echo -e "${RED}Error: gum not found${NC}"
      exit 1
    }
  fi
}

check_crush() {
  if ! command -v crush &>/dev/null; then
    echo -e "${YELLOW}Crush not found. Installing via mise...${NC}"
    
    if command -v mise &>/dev/null; then
      mise use -g crush@latest
    else
      echo -e "${RED}Error: mise not found. Please install mise first.${NC}"
      exit 1
    fi
    
    # Add to PATH for this session
    export PATH="${HOME}/.local/share/mise/shims:${PATH}"
  fi
}

get_nebulanix_models() {
  curl -s --max-time 5 "http://192.168.1.10:11434/api/tags" 2>/dev/null | \
    jq -r '.models[].name' 2>/dev/null || echo ""
}

show_current_config() {
  if [[ -f "$CRUSH_CONFIG" ]]; then
    echo -e "${BLUE}Current Crush Configuration:${NC}"
    echo ""
    cat "$CRUSH_CONFIG"
  else
    echo -e "${YELLOW}No Crush configuration found.${NC}"
    echo "Run 'crush-setup' to create one."
  fi
}

setup_wizard() {
  check_gum
  check_crush
  
  gum style \
    --foreground 212 --border-foreground 212 --border double \
    --align center --width 60 \
    "🤖 Crush Setup" "AI Coding Agent Configuration"
  
  echo ""
  echo -e "${CYAN}Crush is an AI coding agent that integrates with your terminal.${NC}"
  echo -e "${CYAN}It provides LSP support and project-based sessions.${NC}"
  echo ""
  
  # Check nebulanix connectivity
  local nebulanix_available=false
  if curl -s --max-time 3 "${NEBULANIX_URL}/v1/models" > /dev/null 2>&1; then
    echo -e "${GREEN}✅ Nebulanix is reachable${NC}"
    nebulanix_available=true
  else
    echo -e "${YELLOW}⚠️  Nebulanix not reachable. Will configure for local use.${NC}"
  fi
  
  echo ""
  
  # Select default model
  local default_model="qwen3:8b"
  
  if [[ "$nebulanix_available" == true ]]; then
    local models=$(get_nebulanix_models)
    if [[ -n "$models" ]]; then
      echo -e "${BLUE}Select default model:${NC}"
      default_model=$(echo "$models" | gum filter --placeholder "Search models..." --value "qwen3:8b")
    fi
  else
    echo -e "${BLUE}Enter default local model:${NC}"
    default_model=$(gum input --placeholder "qwen3:4b" --value "qwen3:4b")
  fi
  
  echo ""
  
  # Configure server URL
  local server_url="$NEBULANIX_URL"
  if [[ "$nebulanix_available" == false ]]; then
    server_url="http://localhost:11434/v1"
  fi
  
  # LSP integration
  local lsp_enabled="true"
  if gum confirm "Enable LSP integration?" --affirmative="Yes" --negative="No"; then
    lsp_enabled="true"
  else
    lsp_enabled="false"
  fi
  
  echo ""
  
  # Project context
  local project_context="true"
  if gum confirm "Enable project-based context?" --affirmative="Yes" --negative="No"; then
    project_context="true"
  else
    project_context="false"
  fi
  
  echo ""
  
  # Create config
  mkdir -p "$CRUSH_CONFIG_DIR"
  
  cat > "$CRUSH_CONFIG" <<EOF
# Crush Configuration
# Generated by crush-setup on $(date)
# Documentation: https://github.com/charmbracelet/crush

[server]
# Ollama server URL
url = "${server_url}"
api_key = ""
timeout = 300

[models]
# Default model for general use
default = "${default_model}"

# Model shortcuts
fast = "gemma3:4b"
code = "qwen3-coder:30b"
reasoning = "deepseek-r1:8b"

[features]
# LSP integration for codebase understanding
lsp_enabled = ${lsp_enabled}

# Project-based context and sessions
project_context = ${project_context}

# Multi-model support
multi_model = true

# Auto-switch to local if nebulanix unreachable
auto_switch_on_error = true

[ui]
# Theme settings
theme = "dracula"

# Key bindings
quit_key = "q"
EOF

  echo -e "${GREEN}✅ Crush configuration created!${NC}"
  echo ""
  echo "Configuration saved to: $CRUSH_CONFIG"
  echo ""
  echo -e "${BLUE}Next steps:${NC}"
  echo "  1. Run 'crush' to start the AI assistant"
  echo "  2. Use 'connect-ollama' to change models"
  echo "  3. Check 'crush --help' for more options"
  echo ""
  echo -e "${CYAN}Tip: Crush works best when run inside a git repository.${NC}"
}

# Main
while [[ $# -gt 0 ]]; do
  case $1 in
    --reconfigure)
      rm -f "$CRUSH_CONFIG"
      setup_wizard
      exit 0
      ;;
    --show-config)
      show_current_config
      exit 0
      ;;
    --help|-h)
      usage
      ;;
    *)
      echo "Unknown option: $1"
      usage
      ;;
  esac
done

# Check if config already exists
if [[ -f "$CRUSH_CONFIG" ]]; then
  echo -e "${YELLOW}Crush is already configured.${NC}"
  echo ""
  
  if gum confirm "Reconfigure Crush?" --affirmative="Yes, reconfigure" --negative="No, keep current"; then
    rm -f "$CRUSH_CONFIG"
    setup_wizard
  else
    echo "Keeping existing configuration."
    echo ""
    show_current_config
  fi
else
  setup_wizard
fi
