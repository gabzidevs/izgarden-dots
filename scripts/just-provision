#!/usr/bin/env bash

set -e

# =============================================================================
# just-provision - Self-healing host-aware provision script with git branch management
# =============================================================================
# Usage: just-provision [SYSTEM] [OPTIONS]
# =============================================================================

# =============================================================================
# Configuration
# =============================================================================
FLAKE_PATH="${FLAKE_PATH:-/Users/gabz/.config/flake}"
FLAKE="${FLAKE:-.}"
NIX_DARWIN_REPO="github:LnL7/nix-darwin"
DEBUG="${DEBUG:-false}"

# Known systems (using mDNS hostnames)
declare -A SYSTEMS=(
  ["nebulanix"]="nebulanix.local"
  ["spacehound"]="spacehound.local"
)

declare -A SYSTEM_IPS=(
  ["nebulanix"]="192.168.1.10"
  ["spacehound"]="192.168.1.40"
)

# Detection timeout (seconds)
DETECT_TIMEOUT=3
SSH_TIMEOUT=30

validate_system() {
  local system="$1"
  if [[ -z "$system" ]]; then
    return 1
  fi
  
  if [[ -v "SYSTEMS[$system]" ]]; then
    return 0
  fi
  
  print_status error "Unknown system: $system"
  local valid_systems
  valid_systems=$(printf "%s, " "${!SYSTEMS[@]}" | sed 's/, $//')
  echo "Valid systems: $valid_systems"
  return 1
}

parse_ssh_error() {
  local error_output="$1"
  local system="$2"
  
  if echo "$error_output" | grep -qi "timed out\|connection timeout\|no route to host\|could not connect"; then
    print_status error "SSH connection to $system timed out after ${SSH_TIMEOUT}s"
    echo "  Hint: Check if $system is reachable: ping ${SYSTEMS[$system]}"
    return 1
  fi
  
  if echo "$error_output" | grep -qi "connection refused"; then
    print_status error "SSH connection to $system refused"
    echo "  Hint: Check if SSH daemon is running on $system: ssh $USER@${SYSTEMS[$system]} hostname"
    return 1
  fi
  
  if echo "$error_output" | grep -qi "permission denied\|authentication failed\|no supported authentication methods"; then
    print_status error "SSH auth failed for $system"
    echo "  Hint: Check SSH agent: ssh-add -l"
    echo "  Hint: Add key: ssh-add ~/.ssh/id_ed25519"
    return 1
  fi
  
  if echo "$error_output" | grep -qi "host key verification\|known hosts\|strict hostkey\|offending key"; then
    print_status error "SSH host key verification failed for $system"
    echo "  Hint: Remove old host key: ssh-keygen -R ${SYSTEMS[$system]}"
    return 1
  fi
  
  return 0
}

# =============================================================================
# UI & Helper Functions (inspired by oll_core/lib/ui.sh)
# =============================================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

has_gum() { command -v gum &>/dev/null; }

is_interactive() {
  [[ -t 0 ]] && [[ -t 1 ]]
}

select_systems_tui() {
  local title="$1"
  shift
  local systems=("$@")

  if ! has_gum; then
    print_status warn "gum not available, using CLI fallback"
    return 1
  fi

  if ! is_interactive; then
    return 1
  fi

  local choices=()
  for sys in "${systems[@]}"; do
    local ip="${SYSTEM_IPS[$sys]:-unknown}"
    choices+=("$sys ($ip)")
  done

  local selected
  selected=$(gum choose --title="$title" --selected="${choices[0]}" "${choices[@]}" 2>/dev/null) || return 1

  local result
  result=$(echo "$selected" | sed 's/ (.*//')
  echo "$result"
}

select_systems_multi_tui() {
  local title="$1"
  shift
  local systems=("$@")

  if ! has_gum; then
    print_status warn "gum not available, using CLI fallback"
    return 1
  fi

  if ! is_interactive; then
    return 1
  fi

  local choices=()
  local defaults=()
  for sys in "${systems[@]}"; do
    local ip="${SYSTEM_IPS[$sys]:-unknown}"
    choices+=("$sys ($ip)")
    defaults+=("$sys ($ip)")
  done

  local selected
  selected=$(gum choose --title="$title" --selected="${defaults[@]}" --limit=0 "${choices[@]}" 2>/dev/null) || {
    print_status info "No systems selected"
    return 1
  }

  local result
  result=$(echo "$selected" | sed 's/ (.*//' | tr '\n' ',')
  echo "${result%,}"
}

get_remote_systems_for_tui() {
  local current="$1"
  local remote_systems=()

  for sys in "${!SYSTEMS[@]}"; do
    if [[ "$sys" != "$current" ]]; then
      remote_systems+=("$sys")
    fi
  done

  printf '%s\n' "${remote_systems[@]}"
}

print_status() {
  local level="$1"
  local message="$2"
  case "$level" in
    ok|success) echo -e "${GREEN}✓${NC} $message" ;;
    info) echo -e "${BLUE}ℹ${NC} $message" ;;
    warn|warning) echo -e "${YELLOW}⚠${NC} $message" ;;
    error) echo -e "${RED}✗${NC} $message" ;;
    *) echo "$message" ;;
  esac
}

# =============================================================================
# Host Detection (enhanced with multiple methods)
# =============================================================================
debug_log() {
  [[ "$DEBUG" == "true" ]] && echo "[DEBUG] $*"
}

match_system() {
  local value="$1"
  case "$value" in
    192.168.1.10|nebulanix|nebulanix.local) echo "nebulanix" ;;
    192.168.1.40|spacehound|spacehound.local) echo "spacehound" ;;
    *) echo "" ;;
  esac
}

detect_machine() {
  local result=""

  # Method 1: SSH environment variables (existing)
  debug_log "Checking SSH environment variables..."
  if [[ -n "$SSH_CLIENT" || -n "$SSH_CONNECTION" || -n "$SSH_TTY" ]]; then
    if [[ -n "$SSH_CONNECTION" ]]; then
      local target_ip
      target_ip=$(echo "$SSH_CONNECTION" | awk '{print $3}' | cut -d: -f1)
      if [[ -n "$target_ip" ]]; then
        result=$(match_system "$target_ip")
        if [[ -n "$result" ]]; then
          debug_log "Detected via SSH_CONNECTION: $result"
          echo "$result"
          return
        fi
        # Unknown SSH IP - try reverse DNS
        debug_log "Trying reverse DNS on $target_ip..."
        local reverse_result
        reverse_result=$(timeout "$DETECT_TIMEOUT" host "$target_ip" 2>/dev/null | awk '{print $NF}' | sed 's/\.$//' | cut -d. -f1)
        if [[ -n "$reverse_result" ]]; then
          result=$(match_system "$reverse_result")
          if [[ -n "$result" ]]; then
            debug_log "Detected via reverse DNS: $result"
            echo "$result"
            return
          fi
        fi
      fi
    fi
    debug_log "SSH session detected but target not identified"
  fi

  # Method 2: who -m (parse SSH client info)
  debug_log "Checking 'who -m'..."
  local who_output
  who_output=$(who -m 2>/dev/null)
  if [[ -n "$who_output" ]]; then
    debug_log "who -m output: $who_output"
    # Parse IP from: gabz  ttys000  Feb 22 10:30  (192.168.1.10)
    local ip_from_who
    ip_from_who=$(echo "$who_output" | grep -oE '\([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\)' | tr -d '()')
    if [[ -n "$ip_from_who" ]]; then
      result=$(match_system "$ip_from_who")
      if [[ -n "$result" ]]; then
        debug_log "Detected via who -m: $result"
        echo "$result"
        return
      fi
    fi
  fi

  # Method 3: mDNS lookup (dscacheutil on macOS, getent on Linux)
  debug_log "Checking mDNS..."
  for sys in "${!SYSTEMS[@]}"; do
    local mdns_name="${SYSTEMS[$sys]}"
    local mdns_result    
    if [[ "$(uname)" == "Darwin" ]]; then
      # macOS: use dscacheutil with timeout
      mdns_result=$(timeout "$DETECT_TIMEOUT" dscacheutil -q host -a name "$mdns_name" 2>/dev/null | grep "^name" | awk '{print $2}')
    else
      # Linux: use getent
      mdns_result=$(timeout "$DETECT_TIMEOUT" getent hosts "$mdns_name" 2>/dev/null | awk '{print $1}')
    fi
    
    if [[ -n "$mdns_result" ]]; then
      debug_log "mDNS resolved $mdns_name -> $mdns_result"
      # Check if resolved IP matches our known IPs
      if [[ "$mdns_result" == "${SYSTEM_IPS[$sys]}" ]]; then
        # This is our own system, skip
        debug_log "mDNS matched own system ($sys), skipping"
      else
        result=$(match_system "$mdns_result")
        if [[ -n "$result" ]]; then
          debug_log "Detected via mDNS: $result"
          echo "$result"
          return
        fi
      fi
    fi
  done

  # Method 4: Check network interfaces for known IPs
  debug_log "Checking network interfaces..."
  if command -v ip &>/dev/null; then
    local local_ip
    local_ip=$(ip addr show 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | awk '{print $2}' | grep -v '^127\.')
    for ip in $local_ip; do
      result=$(match_system "$ip")
      if [[ -n "$result" ]]; then
        debug_log "Detected via local IP: $result"
        echo "$result"
        return
      fi
    done
  elif command -v ifconfig &>/dev/null; then
    local local_ip
    local_ip=$(ifconfig 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | awk '{print $2}' | grep -v '^127\.')
    for ip in $local_ip; do
      result=$(match_system "$ip")
      if [[ -n "$result" ]]; then
        debug_log "Detected via local IP: $result"
        echo "$result"
        return
      fi
    done
  fi

  # Method 5: Hostname (case-insensitive)
  debug_log "Checking hostname..."
  local hostname_lower
  hostname_lower=$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')

  case "$hostname_lower" in
    nebulanix|nebula*) 
      debug_log "Detected via hostname: nebulanix"
      echo "nebulanix"
      return
      ;;
    spacehound|space*) 
      debug_log "Detected via hostname: spacehound"
      echo "spacehound"
      return
      ;;
  esac

  # Method 6: /etc/hosts fallback
  debug_log "Checking /etc/hosts..."
  if grep -qi "nebulanix" /etc/hosts 2>/dev/null; then
    debug_log "Detected via /etc/hosts: nebulanix"
    echo "nebulanix"
    return
  elif grep -qi "spacehound" /etc/hosts 2>/dev/null; then
    debug_log "Detected via /etc/hosts: spacehound"
    echo "spacehound"
    return
  fi

  # No detection succeeded
  debug_log "Could not detect machine - returning unknown"
  echo "unknown"
}

is_ssh_session() {
  [[ -n "$SSH_CLIENT" || -n "$SSH_CONNECTION" || -n "$SSH_TTY" ]]
}

get_ssh_target() {
  if [[ -n "$SSH_CONNECTION" ]]; then
    echo "$SSH_CONNECTION" | awk '{print $3}' | cut -d: -f1
  fi
}

resolve_ssh_target() {
  local system="$1"
  local hostname="${SYSTEMS[$system]}"
  local fallback_ip="${SYSTEM_IPS[$system]}"

  if [[ -z "$hostname" || -z "$fallback_ip" ]]; then
    print_status error "Unknown system: $system"
    return 1
  fi

  # Try mDNS first with timeout
  debug_log "Resolving $system via mDNS..."
  
  local resolved=""
  
  if [[ "$(uname)" == "Darwin" ]]; then
    # macOS: try dscacheutil first (more reliable on macOS)
    resolved=$(timeout "$DETECT_TIMEOUT" dscacheutil -q host -a name "$hostname" 2>/dev/null | grep "^ip_address" | awk '{print $2}' | head -1)
    if [[ -z "$resolved" ]]; then
      # Fallback to ping -s (BSD ping)
      resolved=$(timeout "$DETECT_TIMEOUT" ping -c 1 -t "$DETECT_TIMEOUT" "$hostname" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
  else
    # Linux: use getent
    resolved=$(timeout "$DETECT_TIMEOUT" getent hosts "$hostname" 2>/dev/null | awk '{print $1}')
    if [[ -z "$resolved" ]]; then
      # Fallback to ping
      resolved=$(timeout "$DETECT_TIMEOUT" ping -c 1 -W "$DETECT_TIMEOUT" "$hostname" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
  fi

  if [[ -n "$resolved" ]]; then
    debug_log "Resolved $system via mDNS: $resolved"
    echo "$resolved"
    return 0
  fi

  # Fallback to IP
  debug_log "Using fallback IP for $system: $fallback_ip"
  echo "$fallback_ip"
}

get_remote_systems() {
  local current="$1"
  local remote_systems=()

  for sys in "${!SYSTEMS[@]}"; do
    if [[ "$sys" != "$current" ]]; then
      remote_systems+=("$sys")
    fi
  done

  if [[ ${#remote_systems[@]} -eq 0 ]]; then
    return 1
  fi

  printf '%s\n' "${remote_systems[@]}"
}

run_provision_mise() {
  local system="$1"
  # use_daemon parameter removed - daemon mode deprecated

  echo "[$system] Starting provision..."

  local result
  result=$(cd "$FLAKE_PATH" && sudo -E nix run "$NIX_DARWIN_REPO" -- switch --flake "$FLAKE#$system" 2>&1)

  local exit_code=$?

  if [[ $exit_code -eq 0 ]] || echo "$result" | grep -q "rebuild in progress"; then
    echo "[$system] ✓ Provision successful"
    return 0
  else
    echo "[$system] ✗ Provision failed (exit code: $exit_code)"
    echo "$result" | sed "s/^/[$system] /"
    return $exit_code
  fi
}

provision_remotes_parallel() {
  local remotes=("$@")
  # use_daemon removed - daemon mode deprecated

  if [[ ${#remotes[@]} -eq 0 ]]; then
    print_status info "No remote systems to provision"
    return 0
  fi

  print_status info "Provisioning ${#remotes[@]} system(s) in parallel: ${remotes[*]}"

  local tmp_dir
  tmp_dir=$(mktemp -d)
  trap "rm -rf $tmp_dir" EXIT

  for remote in "${remotes[@]}"; do
    cat > "$tmp_dir/provision-$remote.sh" << EOF
#!/usr/bin/env bash
source "$FLAKE_PATH/scripts/just-provision"
run_provision_mise "$remote"
EOF
    chmod +x "$tmp_dir/provision-$remote.sh"
  done

  local tasks=()
  for remote in "${remotes[@]}"; do
    tasks+=("$tmp_dir/provision-$remote.sh::$remote")
  done

  local mise_args=("run" "--output" "prefix" "-j" "${#remotes[@]}")
  if [[ "$CONTINUE_ON_ERROR" == "true" ]]; then
    mise_args+=("--continue-on-error")
  fi

  local task_spec=""
  for i in "${!tasks[@]}"; do
    if [[ $i -gt 0 ]]; then
      task_spec+=" ::: "
    fi
    task_spec+="${tasks[$i]}"
  done

  set +e
  eval "${mise_args[@]} $task_spec" 2>&1 | sed 's/^\([^[]*\)\[/\1[/'
  local exit_code=$?
  set -e

  echo ""
  print_status info "Parallel provisioning complete"

  local failed=0
  local succeeded=0

  for remote in "${remotes[@]}"; do
    if [[ -f "$tmp_dir/provision-$remote.sh.exit" ]]; then
      local prov_exit
      prov_exit=$(cat "$tmp_dir/provision-$remote.sh.exit")
      if [[ "$prov_exit" == "0" ]]; then
        ((succeeded++))
      else
        ((failed++))
      fi
    fi
  done

  if [[ $failed -gt 0 ]]; then
    echo "$succeeded succeeded, $failed failed"
    echo "Run: just-provision -b ${BRANCH:-__current__} --heal <failed-system>  # to retry"
    return 1
  else
    echo "All $succeeded system(s) provisioned successfully!"
    return 0
  fi
}

check_ssh_key() {
  # Skip check - rely on SSH agent being already configured
  return 0
}

# Git Operations (NEW - inspired by remote-provision)
# =============================================================================
pull_branch() {
  local branch="$1"

  # Handle special __current__ value
  if [[ "$branch" == "__current__" ]]; then
    branch=$(git branch --show-current)
  fi

  print_status info "Pulling branch: $branch"

  cd "$FLAKE_PATH"

  # Check if branch exists
  if ! git show-ref --verify --quiet "refs/heads/$branch" && \
     ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    print_status error "Branch '$branch' does not exist locally or on origin"
    return 1
  fi

  # Try standard git only - removed opz run block as it was broken
  print_status info "Using git directly..."

  # Fetch from origin
  git fetch origin || {
    print_status error "Failed to fetch from origin"
    return 1
  }

  # If branch doesn't exist locally, create tracking branch
  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      print_status info "Creating local tracking branch for '$branch'"
      git checkout -t "origin/$branch" || {
        print_status error "Failed to create tracking branch"
        return 1
      }
    else
      print_status error "Branch '$branch' not found on origin"
      return 1
    fi
  else
    # Checkout existing branch
    git checkout "$branch" || {
      print_status error "Failed to checkout branch '$branch'"
      return 1
    }
  fi

  # Rebase on origin
  if git rebase "origin/$branch"; then
    print_status ok "Branch '$branch' updated successfully"
  else
    print_status error "Rebase failed - conflicts need manual resolution"
    print_status info "Run: git rebase --abort  # to cancel"
    print_status info "Run: git rebase --continue  # after resolving conflicts"
    return 1
  fi
}

# Interactive handler for uncommitted git changes
handle_pending_changes() {
  if git diff --quiet && git diff --cached --quiet; then
    return 0  # No changes, continue
  fi

  print_status warn "Uncommitted changes detected:"
  git status --short

  # If gum available, use TUI
  if command -v gum &>/dev/null; then
    print_status info "How do you want to handle these changes?"
    
    local choice
    choice=$(gum choose \
      "Auto-commit (grouped by type)" \
      "Single commit (all changes)" \
      "Stash changes" \
      "Abort provision")
    
    case "$choice" in
      "Auto-commit (grouped by type)")
        commit_pending_changes_grouped
        return $?
        ;;
      "Single commit (all changes)")
        local msg
        msg=$(gum input --placeholder "Commit message (conventional format recommended)")
        if [[ -z "$msg" ]]; then
          print_status error "Commit message required"
          return 1
        fi
        git add -A
        git commit -m "$msg"
        return $?
        ;;
      "Stash changes")
        git stash push -m "Auto-stash before provision $(date +%Y-%m-%d_%H:%M:%S)"
        print_status ok "Changes stashed"
        return 0
        ;;
      "Abort provision")
        print_status error "Provision aborted by user"
        return 1
        ;;
      *)
        print_status error "Invalid choice"
        return 1
        ;;
    esac
  else
    # No gum, show manual instructions
    print_status error "Cannot proceed with uncommitted changes"
    print_status info "Options:"
    print_status info "  1. Commit:  git add -A && git commit -m 'message'"
    print_status info "  2. Stash:   git stash"
    print_status info "  3. Discard: git reset --hard HEAD"
    return 1
  fi
}

# Group uncommitted changes and create conventional commits
commit_pending_changes_grouped() {
  print_status info "Analyzing changes for grouped commits..."
  
  # Get all changed files
  local changed_files
  changed_files=$(git status --porcelain | awk '{print $2}')
  
  if [[ -z "$changed_files" ]]; then
    print_status warn "No changes to commit"
    return 0
  fi

  # Define groups with conventional commit prefixes
  local -A groups=(
    ["nix"]="chore(nix)"
    ["scripts"]="chore(scripts)"
    ["docs"]="docs"
    ["ollama"]="feat(ollama)"
    ["systems"]="chore(systems)"
    ["modules"]="chore(modules)"
    ["misc"]="chore"
  )
  
  local -A group_files
  
  # Classify files into groups
  while IFS= read -r file; do
    if [[ "$file" =~ \.nix$ ]] && [[ ! "$file" =~ ^systems/ ]] && [[ ! "$file" =~ ^modules/ ]]; then
      group_files["nix"]+="$file"$'\n'
    elif [[ "$file" =~ ^scripts/ ]] || [[ "$file" =~ ^oll_core/ ]] || [[ "$file" =~ ^opz_core/ ]]; then
      group_files["scripts"]+="$file"$'\n'
    elif [[ "$file" =~ \.md$ ]] || [[ "$file" =~ ^\.opencode/docs/ ]]; then
      group_files["docs"]+="$file"$'\n'
    elif [[ "$file" =~ ollama ]] || [[ "$file" =~ ^ollama-templates/ ]]; then
      group_files["ollama"]+="$file"$'\n'
    elif [[ "$file" =~ ^systems/ ]]; then
      group_files["systems"]+="$file"$'\n'
    elif [[ "$file" =~ ^modules/ ]]; then
      group_files["modules"]+="$file"$'\n'
    else
      group_files["misc"]+="$file"$'\n'
    fi
  done <<< "$changed_files"

  # Create commits for each group
  local commit_count=0
  for group in nix scripts docs ollama systems modules misc; do
    if [[ -n "${group_files[$group]}" ]]; then
      print_status info "Creating commit for group: $group"
      
      # Add files in this group
      while IFS= read -r file; do
        [[ -n "$file" ]] && git add "$file"
      done <<< "${group_files[$group]}"
      
      # Create commit with group prefix
      local commit_msg="${groups[$group]}: auto-commit before provision"
      
      # Add file list to commit body
      local file_list
      file_list=$(echo "${group_files[$group]}" | sed 's/^/  - /')
      
      git commit -m "$commit_msg" -m "Files in this commit:" -m "$file_list"
      
      ((commit_count++))
    fi
  done

  if [[ $commit_count -gt 0 ]]; then
    print_status ok "Created $commit_count grouped commits"
    return 0
  else
    print_status warn "No commits created (all files may be unstaged)"
    return 1
  fi
}

# =============================================================================
# Nix & System Checks
# =============================================================================
check_nix() {
  if ! command -v nix &>/dev/null; then
    print_status error "Nix is not installed!"
    return 1
  fi

  return 0
}

# =============================================================================
# Healing Functions
# =============================================================================

# Helper function to print dry-run messages
heal_dry_run() {
  if [[ "$DRY_RUN" == "true" ]]; then
    print_status info "[DRY-RUN] Would fix: $1"
  fi
}

# Helper function to execute or dry-run a fix
heal_exec() {
  local description="$1"
  local command="$2"
  
  if [[ "$DRY_RUN" == "true" ]]; then
    print_status info "[DRY-RUN] Would execute: $command"
    return 0
  else
    eval "$command" 2>/dev/null || true
    return 0
  fi
}

heal_common_issues() {
  print_status info "Running self-healing checks..."

  # -----------------------------------------------------------------------------
  # Fix nix sandbox issues
  # Nix sandboxing can cause issues on macOS with certain builds.
  # This check warns if sandbox is enabled in the global config.
  # -----------------------------------------------------------------------------
  if [[ -f "/etc/nix/nix.conf" ]]; then
    if grep -q "sandbox = true" /etc/nix/nix.conf; then
      print_status warn "Nix sandbox enabled - may cause issues on macOS"
    fi
  fi

  # -----------------------------------------------------------------------------
  # Fix permission issues on ~/.nix-defexpr
  # Nix needs read access to this directory for channel expressions.
  # -----------------------------------------------------------------------------
  if [[ -d "$HOME/.nix-defexpr" ]]; then
    heal_dry_run "permission on ~/.nix-defexpr"
    heal_exec "permission on ~/.nix-defexpr" "chmod -R 755 \"$HOME/.nix-defexpr\""
  fi

  # -----------------------------------------------------------------------------
  # Fix permission issues on ~/.nix-channels
  # Channel directory should be private for security.
  # -----------------------------------------------------------------------------
  if [[ -d "$HOME/.nix-channels" ]]; then
    heal_dry_run "permission on ~/.nix-channels"
    heal_exec "permission on ~/.nix-channels" "chmod 700 \"$HOME/.nix-channels\""
  fi

  # -----------------------------------------------------------------------------
  # Ensure mise shims are in PATH
  # mise shims must be in PATH for versioned tools to work.
  # -----------------------------------------------------------------------------
  if [[ -d "$HOME/.local/share/mise/shims" ]]; then
    if [[ "$DRY_RUN" != "true" ]]; then
      export PATH="$HOME/.local/share/mise/shims:$PATH"
      print_status info "Added mise shims to PATH"
    else
      print_status info "[DRY-RUN] Would add mise shims to PATH"
    fi
  fi

  # -----------------------------------------------------------------------------
  # Check nix store availability
  # Use nix store ping to verify nix is functional
  # -----------------------------------------------------------------------------
  if ! nix store ping 2>/dev/null; then
    print_status warn "Nix store unavailable"
  fi

  # -----------------------------------------------------------------------------
  # Check for stale lock files
  # Lock files older than 7 days may indicate failed builds.
  # This is informational only - we don't auto-remove locks.
  # -----------------------------------------------------------------------------
  find "$HOME/.config/flake" -name "*.lock" -mtime +7 -type f 2>/dev/null | while read -r lockfile; do
    print_status warn "Stale lock file found: $lockfile"
  done

  print_status ok "Self-healing complete"
}

# Detect which AI model to use for healing
# Returns: model name or empty string (triggers SSH delegation)
detect_heal_model() {
  # Priority 1: User override
  if [[ -n "$HEAL_MODEL" ]]; then
    print_status info "Using model from --heal-model flag: $HEAL_MODEL"
    
    # Validate model exists
    if [[ "$HEAL_MODEL" == opencode/* ]]; then
      # OpenCode cloud model - assume valid
      echo "$HEAL_MODEL"
      return 0
    elif ollama list 2>/dev/null | grep -q "^${HEAL_MODEL}"; then
      # Local Ollama model exists
      echo "$HEAL_MODEL"
      return 0
    else
      print_status warn "Model '$HEAL_MODEL' not found in Ollama, trying anyway..."
      echo "$HEAL_MODEL"
      return 0
    fi
  fi

  # Priority 2: Local Ollama
  if curl -sf http://localhost:11434/api/tags &>/dev/null; then
    print_status info "Local Ollama available, selecting model..."
    
    # Prefer small models for speed
    local preferred=("qwen3-tooled-small" "qwen2.5-small-tooled" "qwen3-coder-tooled" "qwen3-tooled")
    
    for model in "${preferred[@]}"; do
      if ollama list 2>/dev/null | grep -q "^${model}"; then
        print_status info "Selected local model: $model"
        echo "$model"
        return 0
      fi
    done
    
    # Fallback: use first available tooled model
    local first_tooled
    first_tooled=$(ollama list 2>/dev/null | grep "tooled" | head -1 | awk '{print $1}')
    if [[ -n "$first_tooled" ]]; then
      print_status info "Selected local model: $first_tooled"
      echo "$first_tooled"
      return 0
    fi
  fi

  # Priority 3: Remote Ollama (nebulanix)
  if [[ "$DETECTED_HOST" != "nebulanix" ]]; then
    print_status info "Checking remote Ollama at nebulanix.local:11434..."
    
    if curl -sf http://nebulanix.local:11434/api/tags &>/dev/null; then
      print_status info "Remote Ollama available"
      
      # Set OLLAMA_HOST for opencode
      export OLLAMA_HOST="http://nebulanix.local:11434"
      
      # Return a safe model name (assume nebulanix has tooled models)
      echo "qwen3-tooled-small"
      return 0
    fi
  fi

  # Priority 4: No AI available locally - will trigger SSH
  print_status warn "No local or remote Ollama available"
  echo ""
  return 1
}

# Delegate AI healing to nebulanix via SSH
ssh_ai_escalation() {
  local task="$1"
  local context="${2:-}"
  
  print_status info "Delegating AI healing to nebulanix via SSH..."
  
  # Verify we're NOT on nebulanix
  if [[ "$DETECTED_HOST" == "nebulanix" ]]; then
    print_status error "Cannot SSH to self (already on nebulanix)"
    return 1
  fi

  # Verify SSH access
  if ! ssh -o ConnectTimeout=5 nebulanix.local "echo ok" &>/dev/null; then
    print_status error "Cannot SSH to nebulanix.local"
    return 1
  fi

  # Get current branch
  local current_branch
  current_branch=$(git branch --show-current)
  
  if [[ -z "$current_branch" ]]; then
    print_status error "Not on a git branch - cannot sync changes"
    return 1
  fi

  # Build remote AI command
  local remote_cmd="cd ~/.config/flake && "
  
  # Pull latest changes
  remote_cmd+="git fetch origin && git checkout $current_branch && git pull origin $current_branch && "
  
  # Run AI healing based on task
  case "$task" in
    heal_provision_errors)
      remote_cmd+="opencode run --model qwen3-tooled-small 'Analyze and fix nix-darwin provision errors. Focus on flake syntax, missing deps, broken imports. Apply fixes automatically.' && "
      ;;
    fix_flake_errors)
      remote_cmd+="opencode run --model qwen3-coder-tooled 'Fix nix-darwin flake errors: $context. Apply fixes to .nix files.' && "
      ;;
    *)
      remote_cmd+="opencode run --model qwen3-tooled-small 'Fix nix-darwin errors: $task' && "
      ;;
  esac
  
  # Commit changes (if any)
  remote_cmd+="if ! git diff --quiet || ! git diff --cached --quiet; then "
  remote_cmd+="git add -A && "
  remote_cmd+="git commit -m 'fix(provision): AI-assisted fixes via SSH delegation' && "
  remote_cmd+="git push origin $current_branch; "
  remote_cmd+="else echo 'No changes to commit'; fi"

  # Execute on remote
  print_status info "Running AI on nebulanix..."
  if ssh nebulanix.local "$remote_cmd"; then
    print_status ok "AI healing completed on nebulanix"
    
    # Pull changes back
    print_status info "Pulling AI changes back to local..."
    if git pull origin "$current_branch"; then
      print_status ok "AI changes synced to local machine"
      return 0
    else
      print_status error "Failed to pull AI changes from remote"
      return 1
    fi
  else
    print_status error "AI healing failed on nebulanix"
    return 1
  fi
}

heal_ai() {
  print_status info "Running AI-guided self-healing..."

  # Run standard healing first
  heal_common_issues

  if [[ "$DRY_RUN" == "true" ]]; then
    print_status info "[DRY-RUN] Skipping AI-guided healing"
    return 0
  fi

  # Check if we have a heal model specified or can detect one
  local model="${HEAL_MODEL:-}"
  
  if [[ -z "$model" ]]; then
    # Try to detect available model from oll
    if command -v oll &>/dev/null; then
      model=$(oll model list 2>/dev/null | head -1)
    fi
  fi

  if [[ -z "$model" ]]; then
    print_status warn "No AI model available, skipping AI healing"
    return 0
  fi

  print_status info "Using AI model: $model"
  
  # Run opencode in headless mode with timeout
  local ai_prompt="Analyze and fix common nix-darwin provision issues. Check for:
1. Syntax errors in .nix files
2. Missing imports or broken references
3. Flake lock issues
Report what you fixed."

  if timeout 90s opencode run --model "ollama/$model" "$ai_prompt" 2>/dev/null; then
    print_status ok "AI healing suggestions applied"
  else
    print_status warn "AI healing timed out or failed, continuing anyway"
  fi

  print_status ok "AI-guided healing complete"
}

# Classify provision error and escalate to AI if appropriate
escalate_to_ai() {
  local error_log="$1"
  local error_type
  
  print_status info "Classifying provision error..."
  
  # Detect error type from log
  if grep -qi "syntax error\|parse error\|attribute.*not found" "$error_log" 2>/dev/null; then
    error_type="flake"
    print_status info "Detected: Flake syntax/config error"
  elif grep -qi "permission denied\|cannot create\|read-only" "$error_log" 2>/dev/null; then
    error_type="permission"
    print_status info "Detected: Permission/filesystem error"
  elif grep -qi "network\|connection\|timeout\|dns" "$error_log" 2>/dev/null; then
    error_type="network"
    print_status info "Detected: Network error (may be transient)"
  elif grep -qi "nix-daemon\|store.*corrupt\|hash mismatch" "$error_log" 2>/dev/null; then
    error_type="machine"
    print_status info "Detected: Nix daemon/store error"
  else
    error_type="unknown"
    print_status warn "Unknown error type - will attempt generic AI fix"
  fi

  # Route to appropriate fix strategy
  case "$error_type" in
    flake)
      print_status info "Flake errors are AI-fixable, escalating..."
      local model="${HEAL_MODEL:-}"
      
      if [[ -z "$model" ]] && command -v oll &>/dev/null; then
        model=$(oll model list 2>/dev/null | head -1)
      fi

      if [[ -z "$model" ]]; then
        print_status error "No AI model available for flake fix"
        return 1
      fi

      local prompt="Fix nix-darwin flake errors. Error log:
$(tail -50 "$error_log" 2>/dev/null)

Focus on syntax errors, missing attributes, broken imports.
Apply fixes to .nix files and report changes."

      if timeout 90s opencode run --model "ollama/$model" "$prompt" 2>/dev/null; then
        print_status ok "AI fixed flake errors"
        return 0
      else
        print_status error "AI could not fix flake errors"
        return 1
      fi
      ;;
      
    permission)
      print_status error "Permission errors require manual intervention"
      print_status info "Try: sudo chown -R \$(whoami) ~/.config/flake"
      return 1
      ;;
      
    network)
      print_status warn "Network errors are often transient"
      print_status info "Retrying in 5 seconds..."
      sleep 5
      return 2  # Signal retry
      ;;
      
    machine)
      print_status error "Nix daemon/store errors require system-level fixes"
      print_status info "Try: nix store verify --all --repair"
      return 1
      ;;
      
    *)
      print_status warn "Unknown error, attempting generic AI fix..."
      local model="${HEAL_MODEL:-}"
      
      if [[ -z "$model" ]] && command -v oll &>/dev/null; then
        model=$(oll model list 2>/dev/null | head -1)
      fi

      if [[ -n "$model" ]]; then
        timeout 90s opencode run --model "ollama/$model" "Fix nix-darwin provision error: $(tail -20 "$error_log" 2>/dev/null)" 2>/dev/null
        return $?
      else
        print_status error "No AI available for unknown error type"
        return 1
      fi
      ;;
  esac
}

# =============================================================================
# Provisioning Functions
# =============================================================================
run_provision() {
  local system="$1"

  print_status info "Provisioning system: $system"

  # Detect if we're SSH'd into the target
  local current_machine
  current_machine=$(detect_machine)

  if [[ "$current_machine" == "$system" ]] || [[ "$FORCE_LOCAL" == "true" ]]; then
    print_status info "Running provision locally on $system"
    provision_local "$system"
  else
    print_status info "SSH'ing into $system to provision..."
    # Pass branch info for remote execution
    REMOTE_BRANCH="$BRANCH" provision_remote "$system"
  fi
}

provision_local() {
  local system="$1"
  local provision_log="/tmp/provision-$system-$$.log"

  print_status info "Running nix-darwin provision locally..."

  cd "$FLAKE_PATH"

  # Attempt 1: Standard provision
  print_status info "Attempting provision (1/2)..."
  if sudo -E nix run "$NIX_DARWIN_REPO" -- switch --flake "$FLAKE#$system" 2>&1 | tee "$provision_log"; then
    print_status ok "Provision successful!"
    rm -f "$provision_log"
    return 0
  fi

  local exit_code=$?
  
  # Check for "rebuild in progress" which is actually OK
  if grep -q "rebuild in progress" "$provision_log" 2>/dev/null; then
    print_status ok "Provision successful (rebuild in progress detected)"
    rm -f "$provision_log"
    return 0
  fi

  # Provision failed
  print_status error "Provision failed (attempt 1/2, exit code: $exit_code)"

  # If --heal=ai enabled, try to fix and retry
  if [[ "$HEAL_MODE" == "ai" ]]; then
    print_status warn "Attempting AI-powered error recovery..."
    
    escalate_to_ai "$provision_log"
    local escalate_result=$?
    
    case $escalate_result in
      0)
        # AI claims fix applied, retry provision
        print_status info "AI applied fixes, retrying provision (2/2)..."
        if sudo -E nix run "$NIX_DARWIN_REPO" -- switch --flake "$FLAKE#$system" 2>&1 | tee "$provision_log"; then
          print_status ok "Provision completed after AI fix!"
          rm -f "$provision_log"
          return 0
        else
          print_status error "Provision still failed after AI fix"
          print_status info "Error log saved: $provision_log"
          return 1
        fi
        ;;
      2)
        # Network error, already waited - retry
        print_status info "Retrying provision after network delay (2/2)..."
        if sudo -E nix run "$NIX_DARWIN_REPO" -- switch --flake "$FLAKE#$system" 2>&1 | tee "$provision_log"; then
          print_status ok "Provision completed after retry!"
          rm -f "$provision_log"
          return 0
        else
          print_status error "Provision failed after retry"
          print_status info "Error log saved: $provision_log"
          return 1
        fi
        ;;
      *)
        print_status error "AI escalation failed - cannot auto-fix"
        print_status info "Error log saved: $provision_log"
        return 1
        ;;
    esac
  else
    # No healing enabled
    print_status info "Error log saved: $provision_log"
    print_status info "Tip: Use --heal=ai to enable AI-powered error recovery"
    return $exit_code
  fi
}

provision_remote() {
  local system="$1"

  local target
  target=$(resolve_ssh_target "$system") || return 1

  check_ssh_key || {
    print_status error "SSH key check failed"
    return 1
  }

  print_status info "Connecting to $system ($target)..."

  local remote_args="-a $system"

  if [[ -n "$REMOTE_BRANCH" ]]; then
    remote_args+=" --branch \"$REMOTE_BRANCH\""
  fi

  remote_cmd="bash $FLAKE_PATH/scripts/just-provision $remote_args"

  local ssh_output
  ssh_output=$(ssh -A -tt -o ConnectTimeout="$SSH_TIMEOUT" -o StrictHostKeyChecking=accept-new "$target" "$remote_cmd" 2>&1)
  local exit_code=$?

  if [[ $exit_code -eq 0 ]]; then
    print_status ok "Remote provision successful!"
  else
    parse_ssh_error "$ssh_output" "$system" || true
    print_status error "Remote provision failed with exit code: $exit_code"
  fi

  return $exit_code
}

# =============================================================================
# Main Usage & Help
# =============================================================================
usage() {
  echo "just-provision - Self-healing host-aware provision script with git branch management"
  echo ""
  echo "Usage: $0 [SYSTEM] [OPTIONS]"
  echo ""
  echo "Arguments:"
  echo "  SYSTEM          System to provision (nebulanix, spacehound)"
  echo "                  If omitted, auto-detects current host"
  echo ""
  echo "Options:"
  echo "  -a, --as <system>       Provision current machine AS specified system (local)"
  echo "  -ro, --remotes-only     Provision all remote systems (skip current host)"
  echo "  -w, --with [systems]    Provision current host first, then remotes (parallel)"
  echo "  -b, --branch [BRANCH]   Pull git branch before provisioning"
  echo "                          If BRANCH omitted, uses current branch"
  echo "  --heal                 Run self-healing before provision"
  echo "  --heal=ai              Run AI-guided self-healing (standard + opz)"
  echo "  --heal-model <model>   Model to use for AI healing"
  echo "  --dry-run              Show what would be fixed without actually fixing"
  #echo "  --daemon                Use nix-daemon instead of nix without daemon"
  echo "  --timeout <seconds>    SSH connection timeout (default: 30)"
  echo "  --local                 DEPRECATED: Use -a instead"
  echo "  --check                 Just check prerequisites"
  echo "  --debug                 Show detection debug output"
  echo "  -h, --help              Show this help"
  echo ""
  echo "Examples:"
  echo "  $0                       # Auto-detect host, provision locally"
  echo "  $0 nebulanix             # Provision nebulanix (local or remote)"
  echo "  $0 -a nebulanix          # Provision AS nebulanix (local, ignore current host)"
  echo "  $0 -ro                   # Provision all remote systems (skip current host)"
  echo "  $0 -w                    # Provision current host, then all remotes in parallel"
  echo "  $0 -w spacehound         # Provision current host, then spacehound"
  echo "  $0 -w nebulanix,spacehound # Provision current host, then nebulanix and spacehound"
  echo "  $0 -b                    # Pull current branch, provision detected host"
  echo "  $0 -b gabz-v2            # Pull gabz-v2, provision detected host"
  echo "  $0 -b main nebulanix     # Pull main, provision nebulanix"
  echo "  $0 spacehound            # Provision spacehound (SSH if not local)"
  echo "  $0 -b gabz-v2 --heal    # Pull branch, heal, provision detected host"
  echo "  $0 --heal=ai nebulanix   # AI-guided healing + provision"
  echo "  $0 --heal --dry-run      # Show what would be healed without fixing"
  echo "  $0 --check               # Check prerequisites only"
  exit 0
}

# =============================================================================
# Main
# =============================================================================

MODE="provision"
SYSTEM=""
BRANCH=""
HEAL_MODE="none"
HEAL_MODEL=""
DRY_RUN=false
# USE_DAEMON=false  # DEPRECATED - daemon mode removed
FORCE_LOCAL=false
AS_SYSTEM=""
REMOTES_ONLY=false
WITH_SYSTEMS=""
CONTINUE_ON_ERROR=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--as)
      if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
        AS_SYSTEM="$2"
        shift 2
      else
        print_status error "-a/--as requires a system argument"
        usage
      fi
      ;;
    -ro|--remotes-only)
      REMOTES_ONLY=true
      shift
      ;;
    -w|--with)
      if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
        WITH_SYSTEMS="$2"
        shift 2
      else
        WITH_SYSTEMS="__all__"
        shift
      fi
      ;;
    -b|--branch)
      if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
        BRANCH="$2"
        shift 2
      else
        # No branch specified, use current
        BRANCH="__current__"
        shift
      fi
      ;;
    --heal=ai)
      HEAL_MODE="ai"
      shift
      ;;
    --heal-model)
      HEAL_MODEL="$2"
      shift 2
      ;;
    --heal)
      HEAL_MODE="standard"
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    # --daemon removed - daemon mode deprecated
    --local)
      print_status warn "--local is deprecated, use -a instead"
      FORCE_LOCAL=true
      shift
      ;;
    --check)
      MODE="check"
      shift
      ;;
    --debug)
      DEBUG=true
      shift
      ;;
    --timeout)
      if [[ $# -gt 1 && "$2" =~ ^[0-9]+$ ]]; then
        SSH_TIMEOUT="$2"
        shift 2
      else
        shift
      fi
      ;;
    -h|--help)
      usage
      ;;
    *)
      SYSTEM="$1"
      shift
      ;;
  esac
done

case "$MODE" in
  check)
    print_status info "Running prerequisite checks..."
    detected=
    detected=$(detect_machine)
    echo ""
    if is_ssh_session; then
      print_status info "SSH session: yes"
      local ssh_target
      ssh_target=$(get_ssh_target)
      if [[ -n "$ssh_target" ]]; then
        print_status info "SSH target IP: $ssh_target"
      fi
    else
      print_status info "SSH session: no"
    fi
    echo "Detected machine: $detected"
    if [[ "$DEBUG" == "true" ]]; then
      echo "(Run with DEBUG=true for detection details)"
    fi
    check_nix
    ;;
  provision)
    # Branch pull happens FIRST (if requested)
    if [[ "$BRANCH" == "__current__" ]] || [[ -n "$BRANCH" ]]; then
      pull_branch "$BRANCH"
    fi

    # Handle -a/--as flag (provision AS specified system)
    if [[ -n "$AS_SYSTEM" ]]; then
      validate_system "$AS_SYSTEM" || exit 1
      FORCE_LOCAL=true
      SYSTEM="$AS_SYSTEM"
      print_status info "Provisioning as: $SYSTEM"

      if [[ "$HEAL_MODE" == "ai" ]]; then
        heal_ai
      elif [[ "$HEAL_MODE" == "standard" ]]; then
        heal_common_issues
      fi

      run_provision "$SYSTEM"
      exit $?
    fi

    # Handle -ro/--remotes-only flag
    if [[ "$REMOTES_ONLY" == "true" ]]; then
      current=$(detect_machine)
      if [[ "$current" == "unknown" ]]; then
        print_status error "Could not detect current host"
        exit 1
      fi

      mapfile -t remotes < <(get_remote_systems "$current")
      if [[ ${#remotes[@]} -eq 0 ]]; then
        print_status error "No remote systems found for $current"
        exit 1
      fi

      if is_interactive && has_gum; then
        print_status info "Current host: $current"
        local selected
        selected=$(select_systems_multi_tui "Select remote systems to provision" "${remotes[@]}")
        if [[ -z "$selected" ]]; then
          print_status info "No systems selected"
          exit 0
        fi
        IFS=',' read -ra remotes <<< "$selected"
        print_status info "Selected: ${remotes[*]}"
      else
        if ! is_interactive; then
          print_status error "Non-interactive shell, use -w to specify systems"
          exit 1
        fi
        print_status info "Remotes to provision: ${remotes[*]}"
      fi

      if [[ "$HEAL_MODE" == "ai" ]]; then
        heal_ai
      elif [[ "$HEAL_MODE" == "standard" ]]; then
        heal_common_issues
      fi

      provision_remotes_parallel "${remotes[@]}"
      exit $?
    fi

    # Handle -w/--with flag
    if [[ -n "$WITH_SYSTEMS" ]]; then
      current=$(detect_machine)
      if [[ "$current" == "unknown" ]]; then
        print_status error "Could not detect current host"
        exit 1
      fi

      if [[ "$HEAL_MODE" == "ai" ]]; then
        heal_ai
      elif [[ "$HEAL_MODE" == "standard" ]]; then
        heal_common_issues
      fi

      print_status info "Step 1: Provisioning current host ($current)..."
      if ! run_provision "$current"; then
        print_status error "Current host provision failed. Stopping - not provisioning remotes."
        exit 1
      fi

      if [[ "$WITH_SYSTEMS" == "__all__" ]]; then
        mapfile -t remotes < <(get_remote_systems "$current")
      else
        IFS=',' read -ra remotes <<< "$WITH_SYSTEMS"
      fi

      if [[ ${#remotes[@]} -eq 0 ]]; then
        print_status info "No remotes to provision"
        exit 0
      fi

      if is_interactive && has_gum; then
        local selected
        selected=$(select_systems_multi_tui "Select remote systems to provision" "${remotes[@]}")
        if [[ -z "$selected" ]]; then
          print_status info "No systems selected"
          exit 0
        fi
        IFS=',' read -ra remotes <<< "$selected"
        print_status info "Selected: ${remotes[*]}"
      else
        if ! is_interactive && [[ "$WITH_SYSTEMS" == "__all__" ]]; then
          print_status error "Non-interactive shell, specify systems: -w nebulanix,spacehound"
          exit 1
        fi
      fi

      print_status info "Step 2: Provisioning remotes in parallel: ${remotes[*]}..."
      provision_remotes_parallel "${remotes[@]}"
      exit $?
    fi

    # Standard flow: auto-detect system if not specified
    if [[ -z "$SYSTEM" ]]; then
      SYSTEM=$(detect_machine)
      if [[ "$SYSTEM" == "unknown" ]]; then
        print_status error "Could not detect system and none specified"
        usage
      fi
      print_status info "Auto-detected system: $SYSTEM"
    else
      validate_system "$SYSTEM" || exit 1
    fi

    # Run self-healing if requested
    if [[ "$HEAL_MODE" == "ai" ]]; then
      heal_ai
    elif [[ "$HEAL_MODE" == "standard" ]]; then
      heal_common_issues
    fi

    run_provision "$SYSTEM"
    ;;
esac
