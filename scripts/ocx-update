#!/usr/bin/env bash

# ocx-update - Update OCX plugins independently of Nix provisioning
# Usage: ocx-update [--list|--update|--add <plugin>]

set -e

# Configuration
MISE_SHIM="$HOME/.local/share/mise/shims"
OCX_BIN="mise x npm:ocx@latest -- ocx"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

usage() {
  echo "Usage: $0 [COMMAND]"
  echo ""
  echo "Commands:"
  echo "  (no args)         Update all OCX plugins to latest"
  echo "  --list, -l        List current plugins"
  echo "  --add <plugin>    Add a new plugin"
  echo "  --remove <plugin> Remove a plugin"
  echo ""
  echo "Examples:"
  echo "  $0                 # Update all plugins"
  echo "  $0 --list          # Show current plugins"
  echo "  $0 --add npm:opencode-dcp  # Add DCP plugin"
  exit 1
}

# Activate mise
activate_mise() {
  eval "$(${MISE_SHIM}/..activate zsh --shims 2>/dev/null || echo 'export PATH="'"$MISE_SHIM"':$PATH"')"
  export PATH="$MISE_SHIM:$PATH"
}

# List plugins
list_plugins() {
  activate_mise
  echo -e "${GREEN}Current OCX plugins:${NC}"
  cat ~/.config/opencode/opencode.jsonc 2>/dev/null | grep -A 20 '"plugin"' || echo "No plugins found"
}

# Add plugin
add_plugin() {
  local plugin="$1"
  activate_mise
  
  if [[ -z "$plugin" ]]; then
    echo -e "${RED}Error: Please specify a plugin to add${NC}"
    usage
  fi
  
  echo -e "${YELLOW}Adding plugin: $plugin${NC}"
  eval "$OCX_BIN add $plugin --global"
}

# Remove plugin
remove_plugin() {
  local plugin="$1"
  activate_mise
  
  if [[ -z "$plugin" ]]; then
    echo -e "${RED}Error: Please specify a plugin to remove${NC}"
    usage
  fi
  
  echo -e "${YELLOW}Removing plugin: $plugin${NC}"
  # OCX doesn't have remove, so we edit the config manually
  local tmp=$(mktemp)
  jq --arg p "$plugin" '.plugin |= map(select(. != $p))' ~/.config/opencode/opencode.jsonc > "$tmp"
  mv "$tmp" ~/.config/opencode/opencode.jsonc
  echo -e "${GREEN}Removed $plugin${NC}"
}

# Update all plugins
update_plugins() {
  activate_mise
  echo -e "${YELLOW}Updating all OCX plugins...${NC}"
  eval "$OCX_BIN update"
  echo -e "${GREEN}Update complete!${NC}"
}

# Main
case "${1:-}" in
  -l|--list)
    list_plugins
    ;;
  --add)
    add_plugin "$2"
    ;;
  --remove)
    remove_plugin "$2"
    ;;
  --update|-u)
    update_plugins
    ;;
  -h|--help)
    usage
    ;;
  "")
    update_plugins
    ;;
  *)
    echo -e "${RED}Unknown option: $1${NC}"
    usage
    ;;
esac
